# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=12000

# --- Browser ---
# headed is more reliable with LinkedIn; switch to true once stable
HEADLESS=false
USER_DATA_DIR=./user-data

# --- Timing ---
INVITES_POLL_SECONDS=20
MESSAGES_POLL_SECONDS=3
# wait for "several in a row" to finish, but never longer than BURST_MAX_WAIT_MS
BURST_SETTLE_MS=4000
BURST_MAX_WAIT_MS=15000
# pause before inserting the reply (looks natural, never slows us much)
MAX_TYPING_MS=1500

# --- State / logs ---
DB_PATH=./data/bot.db
# true = log message text (local debugging only; never commit logs)
LOG_CONTENT=false
LOG_LEVEL=info
# true = generate replies but never press Send
DRY_RUN=false

# --- Persona (true facts only; the bot never invents anything beyond these) ---
PERSONA_NAME=
PERSONA_HEADLINE=
PERSONA_FACTS=
